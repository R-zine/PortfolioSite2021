{
  "name": "portfolio-site",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "dependencies": {
    "@emailjs/browser": "3.6.2",
    "@react-three/drei": "9.13.0",
    "@react-three/fiber": "8.0.23",
    "@react-three/postprocessing": "2.3.2",
    "gsap": "3.10.4",
    "postprocessing": "6.27.0",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-router-dom": "6.3.0",
    "react-scripts": "5.0.1",
    "three": "0.141.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "5.16.4",
    "@testing-library/react": "13.3.0",
    "@testing-library/user-event": "13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.47",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@types/three": "^0.141.0",
    "eslint": "8.57.1",
    "gltfjsx": "4.6.4",
    "husky": "9.1.7",
    "typescript": "4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "lint": "eslint src --ext .ts,.tsx --max-warnings=0",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --coverage",
    "typecheck": "tsc --noEmit",
    "validate": "yarn lint && yarn typecheck && yarn test:ci && yarn build",
    "precommit": "yarn validate",
    "prepare": "husky",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "overrides": [
      {
        "files": [
          "**/*.test.ts",
          "**/*.test.tsx"
        ],
        "rules": {
          "testing-library/no-container": "off",
          "testing-library/no-node-access": "off"
        }
      }
    ]
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 90,
        "lines": 95,
        "statements": 90
      }
    }
  },
  "resolutions": {
    "three-mesh-bvh": "0.5.11",
    "three-stdlib": "2.10.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
